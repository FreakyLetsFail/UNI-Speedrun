Screen {
    background: $background;
    padding: 0;
}

#dashboard-header {
    width: 100%;
    height: 4;
    align: center middle;
    border-bottom: solid white;
}

.header-line {
    width: 1fr;
    height: 1;
}

#dashboard-titel {
    width: 22;
    height: 3;
    content-align: center middle;
    text-style: bold;
}

#top-info {
    width: 100%;
    height: 5;
    border-bottom: solid white;
}

.info-block {
    width: 1fr;
    height: 4;
    align: center middle;
}

.info-value {
    width: 100%;
    height: 3;
    content-align: center middle;
    text-style: bold;
}

#current-module {
    width: 100%;
    height: auto;
    min-height: 8;
    margin: 1 0;
    align: center middle;
}

.current-title {
    width: auto;
    min-width: 36;
    max-width: 60;
    height: 3;
    border: dashed white;
    padding: 0 2;
    content-align: center middle;
    text-style: bold;
}

.current-subtitle {
    width: 100%;
    height: 2;
    content-align: center middle;
    text-style: bold;
}

.days-left {
    width: 100%;
    height: 1;
    content-align: center middle;
    text-style: bold;
}

#progress-area {
    width: 100%;
    height: auto;
    min-height: 11;
    margin: 1 0;
    align: center middle;
}

#progress-card {
    width: 52;
    height: 10;
    padding: 1 2;
    border: round white;
    align: center middle;
}

#ects-value {
    width: 100%;
    height: 2;
    content-align: center middle;
    text-style: bold;
}

#progress-row {
    width: 100%;
    height: 3;
    align: center middle;
}

.progress-end {
    width: 5;
    height: 1;
    content-align: center middle;
}

#progress-bar {
    width: 1fr;
    height: 1;
    margin: 0 1;
}

#progress-percent {
    width: 100%;
    height: 1;
    content-align: center middle;
    text-style: bold;
}

#next-module {
    width: 100%;
    height: auto;
    min-height: 7;
    margin: 1 0;
    align: center middle;
}

.next-divider-top {
    width: 52;
    height: 1;
    border-top: solid white;
}

.next-divider-bottom {
    width: 52;
    height: 1;
    border-bottom: solid white;
}

#next-title {
    width: 100%;
    height: 2;
    content-align: center middle;
    text-style: bold;
}

#next-details {
    width: 100%;
    height: 2;
    content-align: center middle;
    text-style: bold;
}

#dashboard-actions {
    width: 100%;
    height: 4;
    margin-top: 1;
    border-top: solid white;
    align: center middle;
}

.action {
    width: 1fr;
    height: 3;
    content-align: center middle;
    text-style: bold;
}

#kein-studienplan {
    width: 100%;
    height: 1fr;
    content-align: center middle;
}

/* Einstellungen & Archiv & Modul-Editor */

#settings-screen,
#archive-screen {
    width: 100%;
    height: 1fr;
    padding: 1 3;
}

#modul-editor-screen {
    width: 60;
    height: auto;
    max-height: 90%;
    padding: 1 3;
    border: round white;
    background: $surface;
}

.screen-title {
    width: 100%;
    height: 3;
    content-align: center middle;
    text-style: bold;
}

.section-heading {
    width: 100%;
    height: 2;
    text-style: bold underline;
    margin-bottom: 1;
}

.settings-section,
.archive-section {
    width: 100%;
    margin: 1 0;
    padding: 1 2;
    border: round white;
}

.archive-stats {
    width: 100%;
    height: 3;
    align: center middle;
    content-align: center middle;
    border: round white;
    margin-bottom: 1;
}

.archive-stats-text {
    width: 100%;
    content-align: center middle;
    text-style: bold;
}

.field-label {
    height: 1;
    text-style: bold;
}

.field-input {
    width: 100%;
    margin-bottom: 1;
}

.field-select {
    width: 100%;
    margin-bottom: 1;
}

.screen-actions {
    width: 100%;
    height: 3;
    margin: 1 0;
    align: center middle;
}

.screen-actions Button {
    width: 1fr;
    margin: 0 1;
}

#module-liste {
    width: 100%;
    height: 12;
    min-height: 6;
    max-height: 20;
    margin: 1 0;
}

.module-row {
    width: 100%;
    height: 4;
    border-bottom: solid white;
    align: center middle;
}

.module-name {
    width: 1fr;
    height: 3;
    content-align: left middle;
    text-style: bold;
}

.module-meta {
    width: 20;
    height: 3;
    content-align: center middle;
}

.module-status {
    width: 20;
    height: 3;
    content-align: center middle;
}

.module-action-arrow {
    width: 5;
    min-width: 4;
    height: 3;
    margin: 0 1;
}

.module-action {
    width: 10;
    height: 3;
}

.module-action-done {
    width: 16;
    height: 3;
    margin-right: 1;
}

.module-action-delete {
    width: 6;
    height: 3;
}

.archive-empty {
    width: 100%;
    height: 5;
    content-align: center middle;
}


