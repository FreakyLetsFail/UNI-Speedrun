/* =========================
   Allgemein
   ========================= */

Screen {
    padding: 0;
}

Footer {
    height: 1;
}


/* =========================
   Header
   ========================= */

#dashboard-header {
    width: 100%;
    height: 4;
    align: center middle;
}

.header-line {
    width: 1fr;
    height: 1;
    content-align: center middle;
    color: $text;
}

#dashboard-titel {
    width: 22;
    height: 3;
    content-align: center middle;
    text-style: bold;
}


/* =========================
   Ziel / Prognose / Abweichung
   ========================= */

#top-info {
    width: 100%;
    height: 7;
    margin-top: 1;
    border-top: dashed $text;
    border-bottom: dashed $text;
}

.info-block {
    width: 1fr;
    height: 6;
    align: center middle;
}

.marker {
    width: 100%;
    height: 1;
    content-align: center middle;
    text-style: bold;
}

.info-value {
    width: 100%;
    height: 2;
    content-align: center middle;
    text-style: bold;
}


/* =========================
   Aktuelles Modul
   ========================= */

#current-module {
    width: 100%;
    height: 11;
    margin-top: 1;
    align: center middle;
}

.section-marker {
    width: 100%;
    height: 1;
    content-align: center middle;
    text-style: bold;
}

.current-title {
    width: 42;
    height: 3;
    border: dashed $text;
    padding: 0 1;
    content-align: center middle;
    text-style: bold;
}

.current-subtitle {
    width: 100%;
    height: 2;
    content-align: center middle;
    text-style: bold;
}

.days-left {
    width: 100%;
    height: 1;
    content-align: center middle;
    text-style: bold;
}


/* =========================
   Fortschritt
   ========================= */

#progress-area {
    width: 100%;
    height: 15;
    align: center middle;
}

#progress-card {
    width: 54;
    height: 12;
    padding: 1 2;
    border: round $text;
    align: center middle;
}

#ects-value {
    width: 100%;
    height: 2;
    content-align: center middle;
    text-style: bold;
}

#progress-row {
    width: 100%;
    height: 3;
    align: center middle;
}

.progress-end {
    width: 5;
    height: 1;
    content-align: center middle;
}

#progress-bar {
    width: 1fr;
    height: 1;
    margin: 0 1;
}

#progress-percent {
    width: 100%;
    height: 1;
    content-align: center middle;
    text-style: bold;
}


/* =========================
   Nächstes Modul
   ========================= */

#next-module {
    width: 100%;
    height: 10;
    align: center middle;
}

.next-divider-top,
.next-divider-bottom {
    width: 62%;
    height: 1;
    border-top: dashed $text;
}

.next-divider-bottom {
    border-top: none;
    border-bottom: dashed $text;
}

#next-title {
    width: 100%;
    height: 2;
    content-align: center middle;
    text-style: bold;
}

#next-details {
    width: 100%;
    height: 2;
    content-align: center middle;
    text-style: bold;
}


/* =========================
   Aktionen
   ========================= */

#dashboard-actions {
    width: 100%;
    height: 4;
    margin-top: 1;
    border-top: solid $text;
    align: center middle;
}

.action {
    width: 1fr;
    height: 3;
    content-align: center middle;
    text-style: bold;
}


#kein-studienplan {
    width: 100%;
    height: 1fr;
    content-align: center middle;
}
