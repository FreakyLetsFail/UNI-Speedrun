/* =========================
   Allgemein
   ========================= */

Screen {
    padding: 0 2;
}

Footer {
    height: 1;
}


/* =========================
   Dashboard
   ========================= */

#dashboard-titel {
    width: 100%;
    height: 3;
    content-align: center middle;
    text-style: bold;
    border-bottom: heavy white;
}

#top-info {
    width: 100%;
    height: 7;
    margin-top: 1;
}

.info-block {
    width: 1fr;
    height: 6;
    align: center middle;
}

.marker {
    width: 100%;
    height: 1;
    content-align: center middle;
    text-style: bold;
}

.info-value {
    width: 100%;
    height: 2;
    content-align: center middle;
    text-style: bold;
}


/* =========================
   Aktuelles Modul
   ========================= */

#current-module {
    width: 100%;
    height: 8;
    align: center middle;
    margin-top: 1;
}

.current-title {
    width: auto;
    height: 2;
    border: round white;
    padding: 0 2;
    content-align: center middle;
    text-style: bold;
}

.current-subtitle {
    width: 100%;
    height: 1;
    content-align: center middle;
    text-style: bold;
}

.days-left {
    width: 100%;
    height: 1;
    content-align: center middle;
    text-style: bold;
}


/* =========================
   Fortschritt
   ========================= */

#progress-card {
    width: 32;
    height: 11;
    margin: 1 0;
    padding: 1 2;
    border: round $text;
    align: center middle;
}

#ects-value {
    width: 100%;
    height: 2;
    content-align: center middle;
    text-style: bold;
}

#progress-row {
    width: 100%;
    height: 3;
    align: center middle;
}

.progress-end {
    width: 4;
    height: 1;
    content-align: center middle;
}

#progress-bar {
    width: 1fr;
    height: 1;
    margin: 0 1;
}

#progress-percent {
    width: 100%;
    height: 1;
    content-align: center middle;
    text-style: bold;
}


/* =========================
   Nächstes Modul
   ========================= */

#next-module {
    width: 100%;
    height: 6;
    margin-top: 1;
    align: center middle;
}

#next-module .marker {
    width: 4;
}

#next-title {
    width: auto;
    height: 2;
    content-align: left middle;
    text-style: bold;
}

#next-details {
    width: auto;
    height: 2;
    margin-left: 2;
    content-align: left middle;
    text-style: bold;
}


/* =========================
   Aktionen
   ========================= */

#dashboard-actions {
    width: 100%;
    height: 3;
    margin-top: 1;
    align: center middle;
}

.action {
    width: 1fr;
    height: 2;
    content-align: center middle;
    text-style: bold;
}

#kein-studienplan {
    width: 100%;
    height: 1fr;
    content-align: center middle;
}
