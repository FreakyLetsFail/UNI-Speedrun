Screen {
    background: $background;
    padding: 0;
}

#dashboard-header {
    width: 100%;
    height: 5;
    align: center middle;
    border-bottom: solid white;
}

.header-line {
    width: 1fr;
    height: 1;
}

#dashboard-titel {
    width: 22;
    height: 3;
    content-align: center middle;
    text-style: bold;
}

#top-info {
    width: 100%;
    height: 7;
    border-bottom: solid white;
}

.info-block {
    width: 1fr;
    height: 6;
    align: center middle;
}

.marker {
    width: 100%;
    height: 1;
    content-align: center middle;
    text-style: bold;
}

.info-value {
    width: 100%;
    height: 2;
    content-align: center middle;
    text-style: bold;
}

#current-module {
    width: 100%;
    height: 12;
    margin-top: 1;
    align: center middle;
}

.section-marker {
    width: 100%;
    height: 1;
    content-align: center middle;
    text-style: bold;
}

.current-title {
    width: 42;
    height: 3;
    border: dashed white;
    padding: 0 1;
    content-align: center middle;
    text-style: bold;
}

.current-subtitle {
    width: 100%;
    height: 2;
    content-align: center middle;
    text-style: bold;
}

.days-left {
    width: 100%;
    height: 1;
    content-align: center middle;
    text-style: bold;
}

#progress-area {
    width: 100%;
    height: 16;
    align: center middle;
}

#progress-card {
    width: 54;
    height: 12;
    padding: 1 2;
    border: round white;
    align: center middle;
}

#ects-value {
    width: 100%;
    height: 2;
    content-align: center middle;
    text-style: bold;
}

#progress-row {
    width: 100%;
    height: 3;
    align: center middle;
}

.progress-end {
    width: 5;
    height: 1;
    content-align: center middle;
}

#progress-bar {
    width: 1fr;
    height: 1;
    margin: 0 1;
}

#progress-percent {
    width: 100%;
    height: 1;
    content-align: center middle;
    text-style: bold;
}

#next-module {
    width: 100%;
    height: 10;
    align: center middle;
}

.next-divider-top {
    width: 62%;
    height: 1;
    border-top: solid white;
}

.next-divider-bottom {
    width: 62%;
    height: 1;
    border-bottom: solid white;
}

#next-title {
    width: 100%;
    height: 2;
    content-align: center middle;
    text-style: bold;
}

#next-details {
    width: 100%;
    height: 2;
    content-align: center middle;
    text-style: bold;
}

#dashboard-actions {
    width: 100%;
    height: 5;
    margin-top: 1;
    border-top: solid white;
    align: center middle;
}

.action {
    width: 1fr;
    height: 3;
    content-align: center middle;
    text-style: bold;
}

#kein-studienplan {
    width: 100%;
    height: 1fr;
    content-align: center middle;
}

/* Einstellungen */

#settings-screen,
#archive-screen {
    width: 100%;
    height: 1fr;
    padding: 2 4;
}

.screen-title {
    width: 100%;
    height: 3;
    content-align: center middle;
    text-style: bold;
}

.settings-section,
.archive-section {
    width: 100%;
    margin: 1 0;
    padding: 1 2;
    border: round white;
}

.field-label {
    height: 1;
    text-style: bold;
}

.field-input {
    width: 100%;
    margin-bottom: 1;
}

.screen-actions {
    width: 100%;
    height: 4;
    align: center middle;
}

.screen-actions Button {
    width: 1fr;
    margin: 0 1;
}

.module-row {
    width: 100%;
    height: 4;
    border-bottom: solid white;
    align: center middle;
}

.module-name {
    width: 1fr;
    height: 3;
    content-align: left middle;
}

.module-meta {
    width: 18;
    height: 3;
    content-align: center middle;
}

.module-status {
    width: 18;
    height: 3;
    content-align: center middle;
}

.module-action {
    width: 10;
    height: 3;
}

.archive-empty {
    width: 100%;
    height: 5;
    content-align: center middle;
}
